{
  "name": "draft-auction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @draft/shared build && pnpm --parallel --filter @draft/shared --filter @draft/server --filter @draft/client dev",
    "dev:server": "pnpm --filter @draft/server dev",
    "dev:client": "pnpm --filter @draft/client dev",
    "build": "pnpm --filter @draft/shared build && pnpm --filter @draft/server build && pnpm --filter @draft/client build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @draft/shared build && pnpm -r typecheck",
    "db:sync": "pnpm --filter @draft/server db:sync",
    "db:seed": "pnpm --filter @draft/server db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
