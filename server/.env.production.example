# Production o2switch — copier en .env à la racine de l'app (ou saisir dans cPanel)
NODE_ENV=production
# Passenger fournit le port : ne pas définir PORT.
CLIENT_ORIGIN=https://drafty.example.fr
PUBLIC_DIR=public
TRUST_PROXY=1

GOOGLE_ID=
GOOGLE_SECRET_KEY=
GOOGLE_CALLBACK_URL=https://drafty.example.fr/api/auth/google/callback

# MySQL cPanel (noms préfixés par l'utilisateur cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_drafty
DB_USER=cpaneluser_drafty
DB_PASSWORD=change-moi
DB_LOGGING=false
